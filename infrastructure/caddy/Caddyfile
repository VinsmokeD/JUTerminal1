{$PARALLAX_DOMAIN:localhost} {
    encode zstd gzip

    log {
        output stdout
        format console
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer-when-downgrade
    }

    handle /health {
        reverse_proxy backend:8000
    }

    handle /ws/* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}
