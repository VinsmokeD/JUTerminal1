FROM php:7.4-apache

# Enable Apache modules
RUN a2enmod rewrite headers

# Install MySQL extension, SSH, FTP, and other utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    vsftpd \
    redis-server \
    sudo \
    netcat \
    && docker-php-ext-install pdo pdo_mysql \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Setup SSH
RUN mkdir /var/run/sshd
RUN echo 'root:root' | chpasswd
# Allow root login with password
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config

# Create a vulnerable user
RUN useradd -m -s /bin/bash sysadmin && echo 'sysadmin:admin123' | chpasswd

# Setup vsftpd (anonymous enabled)
COPY vsftpd.conf /etc/vsftpd.conf
RUN mkdir -p /var/run/vsftpd/empty

# Expose Apache status and unauthenticated Redis for controlled lab enumeration
RUN a2enmod status && \
    printf '<Location "/server-status">\\n    SetHandler server-status\\n    Require all granted\\n</Location>\\nExtendedStatus On\\n' > /etc/apache2/conf-enabled/server-status.conf && \
    printf 'bind 0.0.0.0\\nprotected-mode no\\nappendonly no\\nsave ""\\n' > /etc/redis/redis.conf

# Copy intentionally vulnerable application
COPY index.php /var/www/html/index.php
COPY init.sql /docker-entrypoint-initdb.d/
COPY robots.txt /var/www/html/robots.txt
COPY swagger.json /var/www/html/swagger.json
COPY .env_leak /var/www/html/.env.bak
COPY backup.zip /var/www/html/backup.zip
COPY phpmyadmin/ /var/www/html/phpmyadmin/
COPY git-seed/ /var/www/html/.git/

# Create upload directory (writable — intentional for file upload vuln)
RUN mkdir -p /var/www/html/uploads && chmod 777 /var/www/html/uploads
COPY uploads.htaccess /var/www/html/uploads/.htaccess

# Create fake records
RUN mkdir -p /var/www/html/records && \
    echo "Patient: John Smith\nDOB: 1985-03-12\nDiagnosis: Hypertension\nSSN: 123-45-6789" > /var/www/html/records/patient_1.txt && \
    echo "Patient: Mary Johnson\nDOB: 1990-07-04\nDiagnosis: Type 2 Diabetes\nSSN: 987-65-4321" > /var/www/html/records/patient_2.txt

# Apache ServerTokens — intentional information disclosure for training
RUN echo "ServerSignature On" >> /etc/apache2/apache2.conf && \
    echo "ServerTokens Full" >> /etc/apache2/apache2.conf && \
    echo 'Header set X-Powered-By "PHP/7.4.3"' > /etc/apache2/conf-enabled/novamed-headers.conf

# Add entrypoint script
COPY entrypoint.sh /usr/local/bin/
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

# Non-root execution is NOT done here intentionally — old Apache/PHP setup for realism
EXPOSE 80 21 22 6379

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
