FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    DOMAIN=nexora.local \
    REALM=NEXORA.LOCAL \
    NETBIOS_NAME=NEXORA \
    ADMINPASS=NexoraAdmin2024!

# Samba4 AD Domain Controller with Kerberos + Audit support
RUN apt-get update && apt-get install -y --no-install-recommends \
    samba \
    samba-common \
    samba-common-bin \
    samba-dsdb-modules \
    samba-vfs-modules \
    smbclient \
    winbind \
    krb5-user \
    krb5-config \
    dnsutils \
    net-tools \
    netcat-openbsd \
    python3 \
    openssl \
    supervisor \
    ldb-tools \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Patch Samba's setntacl so that smbd.set_nt_acl() failures on Docker overlay
# filesystems do not abort domain provisioning. The training scenario does not
# rely on sysvol NT ACLs, but the upstream provisioner aborts on the first
# NT_STATUS_ACCESS_DENIED. The patch wraps the C call in try/except so the
# rest of provisioning still completes (database, users, SPNs, Kerberos).
RUN python3 - <<'PYEOF'
import re, pathlib
p = pathlib.Path('/usr/lib/python3/dist-packages/samba/ntacls.py')
src = p.read_text()
needle = 'smbd.set_nt_acl(\n            file, SECURITY_SECINFO_FLAGS, sd,\n            service=service, session_info=session_info)'
replacement = (
    'try:\n'
    '            smbd.set_nt_acl(\n'
    '                file, SECURITY_SECINFO_FLAGS, sd,\n'
    '                service=service, session_info=session_info)\n'
    '        except Exception as _e:\n'
    '            import sys\n'
    '            print(f"[parallax] tolerating smbd.set_nt_acl failure on {file}: {_e}", file=sys.stderr)'
)
if needle in src:
    p.write_text(src.replace(needle, replacement))
    print('[parallax] patched samba.ntacls.setntacl')
else:
    print('[parallax] WARNING: setntacl pattern not found; aborting')
    raise SystemExit(1)
PYEOF

# Domain provisioning script (Kerberos config handled inline in script)
COPY provision-dc.sh /provision-dc.sh
COPY sysvol-seed/ /opt/parallax/sysvol-seed/
COPY samba-supervisor.conf /etc/supervisor/conf.d/samba.conf
RUN chmod +x /provision-dc.sh

# Expose required ports for AD services
EXPOSE 389 636 88 445 53 3268 3269

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD smbclient -L 127.0.0.1 -N > /dev/null 2>&1 || exit 1

CMD ["/provision-dc.sh"]
