# CyberSim environment template.
# Copy this file to .env and replace secrets before running the stack.

# Public demo hostname for local or HTTPS demo front doors.
CYBERSIM_DOMAIN=localhost

# Runtime environment used by backend and frontend Docker builds.
ENVIRONMENT=development

# Backend logging level.
LOG_LEVEL=INFO

# JWT signing secret; generate with: openssl rand -hex 32
JWT_SECRET=<generate: openssl rand -hex 32>

# JWT lifetime in hours.
JWT_EXPIRY_HOURS=8

# Default instructor account seeded on first boot. CHANGE THESE for any shared
# deployment — the default password is rejected outright when ENVIRONMENT=production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CyberSimAdmin!

# Postgres bootstrap username.
POSTGRES_USER=cybersim

# Postgres bootstrap password.
POSTGRES_PASSWORD=cybersim

# Postgres database name.
POSTGRES_DB=cybersim

# Backend SQLAlchemy async database URL.
POSTGRES_URL=postgresql+asyncpg://cybersim:cybersim@postgres:5432/cybersim

# Redis URL used by backend real-time state and WebSocket replay.
REDIS_URL=redis://redis:6379/0

# Allowed browser origins for FastAPI CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost

# OpenRouter API key for the AI monitor.
OPENROUTER_API_KEY=<your OpenRouter API key>

# Budget/performance AI monitor model selected for CyberSim.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Maximum tokens returned by the AI monitor.
OPENROUTER_MAX_TOKENS=150

# Per-session AI monitor cooldown in seconds.
AI_CALL_COOLDOWN_SECONDS=10

# Docker socket path mounted into the backend container.
DOCKER_SOCKET=/var/run/docker.sock

# Scenario Docker network prefix.
SCENARIO_NETWORK_PREFIX=172.20

# Kali sandbox image tag used for student terminals.
KALI_IMAGE=cybersim-kali:latest

# Maximum concurrent sandbox sessions.
MAX_CONCURRENT_SESSIONS=10

# Per-sandbox Docker CPU limit.
CONTAINER_CPU_LIMIT=1.0

# Per-sandbox Docker memory limit.
CONTAINER_MEMORY_LIMIT=512m

# Level 1 hint score penalty.
HINT_L1_PENALTY=5

# Level 2 hint score penalty.
HINT_L2_PENALTY=10

# Level 3 hint score penalty.
HINT_L3_PENALTY=20

# Minutes allowed before the completion time bonus expires.
TIME_BONUS_THRESHOLD_MINUTES=120

# SC-02 Nexora domain admin password.
SC02_ADMIN_PASS=NexoraAdmin2024!

# Frontend API base URL baked into the Vite build.
VITE_API_URL=/api

# Frontend WebSocket base URL; empty means derive from current host.
VITE_WS_URL=
