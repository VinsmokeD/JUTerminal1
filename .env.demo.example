# CyberSim demo-day environment.
# Copy to .env on the VPS, then replace placeholders before starting the stack.

CYBERSIM_DOMAIN=demo.example.com

GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=150
AI_CALL_COOLDOWN_SECONDS=10

POSTGRES_USER=cybersim
POSTGRES_PASSWORD=replace_with_generated_database_password
POSTGRES_DB=cybersim
POSTGRES_URL=postgresql+asyncpg://cybersim:replace_with_generated_database_password@postgres:5432/cybersim

REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace_with_64_character_hex_secret
JWT_EXPIRY_HOURS=8

DOCKER_SOCKET=/var/run/docker.sock
SCENARIO_NETWORK_PREFIX=172.20
KALI_IMAGE=cybersim-kali:latest
MAX_CONCURRENT_SESSIONS=5
CONTAINER_CPU_LIMIT=0.5
CONTAINER_MEMORY_LIMIT=512m

ENVIRONMENT=production
CORS_ORIGINS=https://demo.example.com,http://demo.example.com,http://localhost,http://localhost:3000
LOG_LEVEL=INFO

SC02_ADMIN_PASS=NexoraAdmin2024!

HINT_L1_PENALTY=5
HINT_L2_PENALTY=10
HINT_L3_PENALTY=20
TIME_BONUS_THRESHOLD_MINUTES=120

VITE_API_URL=/api
VITE_WS_URL=
