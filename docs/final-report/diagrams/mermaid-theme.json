{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "'Rajdhani', 'Segoe UI', Arial, sans-serif",
    "fontSize": "14px",
    "background": "#0A0F1C",

    "primaryColor": "#0D1423",
    "primaryTextColor": "#EAF1FB",
    "primaryBorderColor": "#00F0FF",

    "secondaryColor": "#111827",
    "secondaryTextColor": "#EAF1FB",
    "secondaryBorderColor": "#C8A94A",

    "tertiaryColor": "#1A2235",
    "tertiaryTextColor": "#EAF1FB",
    "tertiaryBorderColor": "#1FA268",

    "lineColor": "#00F0FF",
    "textColor": "#EAF1FB",
    "mainBkg": "#0D1423",
    "nodeBorder": "#00F0FF",

    "clusterBkg": "#111827",
    "clusterBorder": "#C8A94A",
    "titleColor": "#EAF1FB",
    "edgeLabelBackground": "#0A0F1C",

    "actorBkg": "#0D1423",
    "actorBorder": "#00F0FF",
    "actorTextColor": "#EAF1FB",
    "actorLineColor": "#00F0FF",

    "signalColor": "#00F0FF",
    "signalTextColor": "#EAF1FB",

    "labelBoxBkgColor": "#111827",
    "labelBoxBorderColor": "#00F0FF",
    "labelTextColor": "#EAF1FB",

    "loopTextColor": "#C8A94A",

    "noteBkgColor": "#1A2235",
    "noteTextColor": "#C8A94A",
    "noteBorderColor": "#C8A94A",

    "entityBkg": "#0D1423",
    "entityBorder": "#00F0FF",
    "attributeBackgroundColorOdd": "#0A0F1C",
    "attributeBackgroundColorEven": "#111827",
    "relationshipLabelBackground": "#0A0F1C",

    "stateBkg": "#0D1423",
    "stateBorder": "#00F0FF",
    "transitionColor": "#1FA268",

    "git0": "#00F0FF",
    "git1": "#C8A94A",
    "git2": "#1FA268",
    "git3": "#00B4D8",
    "git4": "#0096C7",
    "git5": "#023E8A",
    "git6": "#0077B6",
    "git7": "#03045E"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "orthogonal",
    "nodeSpacing": 60,
    "rankSpacing": 72,
    "padding": 20,
    "diagramPadding": 24
  },
  "sequence": {
    "mirrorActors": true,
    "showSequenceNumbers": true,
    "actorMargin": 80,
    "messageMargin": 48,
    "diagramMarginX": 24,
    "diagramMarginY": 24,
    "boxMargin": 12,
    "boxTextMargin": 8,
    "noteMargin": 12,
    "width": 160,
    "height": 52
  },
  "er": {
    "useMaxWidth": true,
    "diagramPadding": 20,
    "entityPadding": 16,
    "minEntityWidth": 100,
    "minEntityHeight": 75
  },
  "state": {
    "diagramPadding": 20,
    "nodeSpacing": 60,
    "rankSpacing": 72
  }
}
